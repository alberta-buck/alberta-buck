# Alberta Buck -- RPC endpoint configuration
#
# Copy to .env and fill in your API key.
# Free tier: https://dashboard.alchemy.com/ or https://infura.io/
#
# Two environment variables control RPC connections:
#
#   MAINNET_RPC_URL   Remote archive RPC (Alchemy, Infura, or local Reth/Geth).
#                     Used by Foundry (forge --fork-url) and Anvil (--fork-url)
#                     to access Ethereum mainnet state.  Also used by the Python
#                     tests when connecting directly (no Anvil).
#
#   ETH_RPC_URL       Where the Python tests send queries.  Override this to
#                     http://localhost:8545 when running against a local Anvil
#                     fork.  If unset, falls back to MAINNET_RPC_URL.
#
# Typical workflows:
#
#   Direct RPC (Python hits Alchemy directly):
#     export MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
#     make nix-test-python
#
#   Via Anvil (Anvil hits Alchemy; Python hits Anvil):
#     # Terminal 1 -- Anvil uses MAINNET_RPC_URL from .env
#     make nix-fork-mainnet
#     # Terminal 2 -- Python queries Anvil on localhost
#     ETH_RPC_URL=http://localhost:8545 make nix-test-python

MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
