+
+    /// alberta-buck patch: the executor keeps every call's journal open (it skips revm's
+    /// finalization so state persists between calls), so the journal of state accesses and the
+    /// log list grew with every call for the life of the EVM (about 86 kB a transaction in a
+    /// five-year simulation). With no checkpoint outstanding, nothing can revert into them, and
+    /// the call's logs are already in its result: reset both to their initial state. The state
+    /// itself (accounts, storage, their warm status) is untouched, so execution and gas are
+    /// unchanged.
+    fn release_journal(&mut self) {
+        let journaled = &mut self.context.journaled_state;
+        if self.checkpoints.is_empty() && journaled.depth == 0 {
+            journaled.journal = vec![vec![]];
+            journaled.logs = Vec::new();
+        }
+    }
 }
