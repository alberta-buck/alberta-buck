# Foundry build artifacts
/out/
/cache/
/broadcast/
/.anvil-cache/

# SNARK toolchain outputs (regenerated by scripts/snark/setup.sh
# and scripts/snark/prove_mint.js)
/build/

# Dependency directories (installed via forge install)
/lib/

# Nix
/result

# Environment (may contain RPC API keys)
.env

# Editor temporaries
*~
.#*
.DS_Store

# Node (if used for tooling)
node_modules/

# Rust (core/rust workspace; lockfile committed once binding crates land)
/core/rust/target/
/core/rust/Cargo.lock

# Built kernel bindings (make nix-core-build)
/core/python/buck_core/*.so
/core/js/wasm/
/core/js/demo/wasm-web/

# Bundled forge artifacts for the JS platform (make nix-core-js-artifacts)
/core/js/artifacts/

# The bundled buckworld demo app (make nix-core-demo-buckworld)
/core/js/demo/app.js

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/


# Default equilibrium-sweep scratch output (named campaigns live in
# test/vectors/sweep-<name>/ and ARE committed)
/test/vectors/sweep/

# Coverage
lcov.info
*.aux
*.toc
*.tex
*.fls
*.log
foundry.lock
/raw-materials-price/
