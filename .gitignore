# Foundry build artifacts
/out/
/cache/
/broadcast/
/.anvil-cache/

# SNARK toolchain outputs (regenerated by scripts/snark/setup.sh
# and scripts/snark/prove_mint.js)
/build/

# Dependency directories (installed via forge install)
/lib/

# Nix
/result

# Environment (may contain RPC API keys)
.env

# Editor temporaries
*~
.#*
.DS_Store

# Node (if used for tooling)
node_modules/

# Rust (core/rust workspace).  Cargo.lock IS committed: published wheels
# and wasm must be reproducible from a tag (alberta-buck-deployment.org, P0).
/core/rust/target/

# Built kernel bindings (make nix-core-build).  core/js/kernel/{node,web}
# are the wasm halves of the published alberta-buck-kernel package; its
# package.json and README are tracked, the build outputs are not.
/core/python/buck_core/*.so
/core/js/kernel/node/
/core/js/kernel/web/
/core/js/demo/wasm-web/

# Bundled forge artifacts for the JS platform (make nix-core-js-artifacts)
/core/js/artifacts/

# The bundled demo apps (make nix-core-demo-buckworld / -eqworld)
/core/js/demo/app.js
/core/js/demo/eqapp.js

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/


# Default equilibrium-sweep scratch output (named campaigns live in
# test/vectors/sweep-<name>/ and ARE committed)
/test/vectors/sweep/

# Coverage
lcov.info
*.aux
*.toc
*.tex
*.fls
*.log
foundry.lock
/raw-materials-price/

# window-stamped historical CSVs are generated caches
alberta_buck/sim/prices/hist-*-*d.csv
alberta_buck/sim/prices/hist-manifest-*.json
